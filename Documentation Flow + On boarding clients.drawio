        <mxCell id="RG1MbGFf5ctaDujEfwZt-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" value="&lt;b&gt;Entra ID + APIM&lt;/b&gt;&lt;div&gt;&lt;i&gt;Auth + resolve TenantId&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="150" x="220" y="320" as="geometry" />
        </mxCell>
        <mxCell id="RG1MbGFf5ctaDujEfwZt-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;gradientColor=#97d077;strokeColor=#82b366;" value="&lt;b&gt;Tenant Context&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;i&gt;Scope all data access&lt;/i&gt;&lt;/div&gt;" vertex="1">
