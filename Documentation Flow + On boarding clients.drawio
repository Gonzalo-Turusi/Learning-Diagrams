        <mxCell id="Kx8qWcYF5ekzFVOqTByy-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Isolated services" vertex="1">
          <mxGeometry height="30" width="100" x="700" y="935" as="geometry" />
        </mxCell>
      </root>
