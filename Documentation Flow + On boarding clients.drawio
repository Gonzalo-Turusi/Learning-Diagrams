        <mxCell id="RG1MbGFf5ctaDujEfwZt-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Shared app tier - One deployment, all tenants" vertex="1">
