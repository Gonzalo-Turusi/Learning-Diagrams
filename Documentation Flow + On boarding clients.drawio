        <mxCell id="48-8rRfII4qTbJ0b_MYv-74" connectable="0" parent="48-8rRfII4qTbJ0b_MYv-73" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="New Notification" vertex="1">
          <mxGeometry relative="1" x="0.191" y="1" as="geometry">
